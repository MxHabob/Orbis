{
  "name": "orbis",
  "packageManager": "bun@1.2.22",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo dev jobs --parallel --continue",
    "test": "turbo test --parallel",
    "start:dashboard": "turbo start --filter=@orbis/dashboard",
    "dev:api": "turbo dev --filter=@orbis/api",
    "dev:dashboard": "turbo dev --filter=@orbis/dashboard",
    "build:dashboard": "turbo build --filter=@orbis/dashboard",
    "seed": "bun packages/db/src/seed.ts",
    "dev:desktop": "turbo dev --filter=@orbis/desktop",
    "dev:desktop:staging": "turbo run tauri:staging --filter=@orbis/desktop",
    "dev:desktop:prod": "turbo run tauri:prod --filter=@orbis/desktop",
    "build:desktop:staging": "turbo run tauri:build:staging --filter=@orbis/desktop",
    "build:desktop:prod": "turbo run tauri:build:prod --filter=@orbis/desktop",
    "format": "biome format --write .",
    "lint": "turbo lint && manypkg check",
    "typecheck": "turbo typecheck",
    "worker": "bun run packages/jobs/src/worker.ts",
    "docker:up": "docker compose -f docker-compose.local.yml up -d",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "docker:reset": "docker compose -f docker-compose.local.yml down -v",
    "docker:logs": "docker compose -f docker-compose.local.yml logs -f",
    "db:push": "cd packages/db && bunx drizzle-kit push",
    "db:migrate": "cd packages/db && bunx drizzle-kit migrate",
    "setup:local": "powershell -ExecutionPolicy Bypass -File scripts/start-local.ps1"
  },
  "dependencies": {
    "@biomejs/biome": "2.3.13",
    "@manypkg/cli": "^0.25.1",
    "@orbis/tsconfig": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "turbo": "^2.9.17",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "tailwindcss": "3.4.17"
  }
}
