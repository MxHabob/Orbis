{
  "name": "mulboi",
  "packageManager": "bun@1.2.22",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo dev jobs --parallel --continue",
    "test": "turbo test --parallel",
    "start:dashboard": "turbo start --filter=@midday/dashboard",
    "dev:api": "turbo dev --filter=@midday/api",
    "dev:dashboard": "turbo dev --filter=@midday/dashboard",
    "build:dashboard": "turbo build --filter=@midday/dashboard",
    "seed": "bun packages/db/src/seed.ts",
    "dev:desktop": "turbo dev --filter=@midday/desktop",
    "format": "biome format --write .",
    "lint": "turbo lint && manypkg check",
    "typecheck": "turbo typecheck",
    "worker": "bun run packages/jobs/src/worker.ts"
  },
  "dependencies": {
    "@biomejs/biome": "2.3.13",
    "@manypkg/cli": "^0.25.1",
    "@midday/tsconfig": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "turbo": "^2.8.12",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "tailwindcss": "3.4.17"
  }
}
