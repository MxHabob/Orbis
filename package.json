{
  "name": "orbis",
  "packageManager": "bun@1.2.22",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/api-rust",
    "apps/dashboard",
    "apps/desktop-svelte"
  ],
  "catalog": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.9.3",
    "date-fns": "^4.1.0"
  },
  "scripts": {
    "sdk:sync": "bun packages/sdk/scripts/generate-types.ts",
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo dev --parallel --continue",
    "test": "turbo test --parallel",
    "dev:api-go": "turbo dev --filter=@orbis/api-go",
    "dev:dashboard": "turbo dev --filter=@orbis/dashboard",
    "build:dashboard": "turbo build --filter=@orbis/dashboard",
    "dev:desktop-svelte": "turbo dev --filter=@orbis/desktop-svelte",
    "dev:desktop-svelte:dev": "turbo run tauri:dev --filter=@orbis/desktop-svelte",
    "dev:desktop-svelte:staging": "turbo run tauri:staging --filter=@orbis/desktop-svelte",
    "dev:desktop-svelte:prod": "turbo run tauri:prod --filter=@orbis/desktop-svelte",
    "build:desktop-svelte:staging": "turbo run tauri:build:staging --filter=@orbis/desktop-svelte",
    "build:desktop-svelte:prod": "turbo run tauri:build:prod --filter=@orbis/desktop-svelte",
    "format": "biome format --write .",
    "lint": "turbo lint && manypkg check",
    "typecheck": "turbo typecheck",
    "docker:up": "docker compose -f docker-compose.local.yml up -d",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "docker:reset": "docker compose -f docker-compose.local.yml down -v",
    "docker:logs": "docker compose -f docker-compose.local.yml logs -f",
    "setup:local": "powershell -ExecutionPolicy Bypass -File scripts/start-local.ps1"
  },
  "dependencies": {
    "@biomejs/biome": "2.3.13",
    "@manypkg/cli": "^0.25.1",
    "@orbis/tsconfig": "workspace:*",
    "turbo": "^2.10.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "tailwindcss": "4.3.1",
    "@tailwindcss/postcss": "4.3.1",
    "@tailwindcss/vite": "4.3.1"
  }
}
