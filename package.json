{
  "name": "orbis",
  "packageManager": "bun@1.2.22",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/api-rust",
    "apps/desktop",
    "apps/mobile"
  ],
  "catalog": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^7.0.2",
    "date-fns": "^4.4.0"
  },
  "scripts": {
    "generate:api": "cargo run --manifest-path apps/api-rust/Cargo.toml -p orbis-server --bin export_openapi",
    "generate:sdk": "bun run --cwd packages/sdk generate",
    "generate": "bun run generate:api && bun run generate:sdk",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:commit": "node scripts/commit-release.mjs",
    "i18n:audit": "bun run scripts/i18n-audit.ts",
    "build": "turbo run build",
    "dev": "turbo run dev --continue",
    "test": "turbo run test",
    "dev:api": "cargo run --manifest-path apps/api-rust/Cargo.toml -p orbis-server --bin orbis-server",
    "dev:mobile": "turbo run dev --filter=@orbis/mobile",
    "dev:mobile:tunnel": "turbo run start:tunnel --filter=@orbis/mobile",
    "mobile:android": "turbo run android:device --filter=@orbis/mobile",
    "mobile:prebuild": "turbo run prebuild:clean --filter=@orbis/mobile",
    "dev:desktop": "turbo run tauri:dev --filter=@orbis/desktop",
    "dev:desktop:staging": "turbo run tauri:staging --filter=@orbis/desktop",
    "dev:desktop:prod": "turbo run tauri:prod --filter=@orbis/desktop",
    "build:desktop:staging": "turbo run tauri:build:staging --filter=@orbis/desktop",
    "build:desktop:prod": "turbo run tauri:build:prod --filter=@orbis/desktop",
    "format": "biome format --write .",
    "lint": "turbo run lint && manypkg check",
    "typecheck": "turbo run typecheck",
    "cli": "cargo run --manifest-path apps/cli/Cargo.toml",
    "cli:init": "cargo run --manifest-path apps/cli/Cargo.toml -- init"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@manypkg/cli": "^0.25.1",
    "@orbis/tsconfig": "workspace:*",
    "@types/node": "^26.1.1",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "tailwindcss": "4.3.1",
    "@tailwindcss/postcss": "4.3.1",
    "@tailwindcss/vite": "4.3.1"
  }
}
