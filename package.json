{
  "name": "orbis",
  "packageManager": "bun@1.2.22",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/api-rust",
    "apps/desktop",
    "apps/mobile"
  ],
  "catalog": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^7.0.2",
    "date-fns": "^4.1.0"
  },
  "scripts": {
    "generate": "bun run scripts/generate-types.ts && bun run scripts/generate-rpc.ts",
    "i18n:audit": "bun run scripts/i18n-audit.ts",
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo dev --parallel --continue",
    "test": "turbo test --parallel",
    "dev:desktop": "turbo dev --filter=@orbis/desktop",
    "dev:mobile": "turbo dev --filter=@orbis/mobile",
    "dev:mobile:tunnel": "turbo run start:tunnel --filter=@orbis/mobile",
    "mobile:android": "turbo run android:device --filter=@orbis/mobile",
    "mobile:prebuild": "turbo run prebuild:clean --filter=@orbis/mobile",
    "dev:desktop:dev": "turbo run tauri:dev --filter=@orbis/desktop",
    "dev:desktop:staging": "turbo run tauri:staging --filter=@orbis/desktop",
    "dev:desktop:prod": "turbo run tauri:prod --filter=@orbis/desktop",
    "build:desktop:staging": "turbo run tauri:build:staging --filter=@orbis/desktop",
    "build:desktop:prod": "turbo run tauri:build:prod --filter=@orbis/desktop",
    "format": "biome format --write .",
    "lint": "turbo lint && manypkg check",
    "typecheck": "turbo typecheck",
    "docker:up": "docker compose -f docker-compose.local.yml up -d",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "docker:reset": "docker compose -f docker-compose.local.yml down -v",
    "docker:logs": "docker compose -f docker-compose.local.yml logs -f",
    "cli": "cargo run --manifest-path apps/cli/Cargo.toml",
    "cli:init": "cargo run --manifest-path apps/cli/Cargo.toml -- init"
  },
  "dependencies": {
    "@biomejs/biome": "2.3.13",
    "@manypkg/cli": "^0.25.1",
    "@orbis/tsconfig": "workspace:*",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "tailwindcss": "4.3.1",
    "@tailwindcss/postcss": "4.3.1",
    "@tailwindcss/vite": "4.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
