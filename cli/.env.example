# =============================================================================
# Orbis — School Local Deployment Environment (.env)
# =============================================================================
# Copy this file to '.env' and edit the values below to match the school server.
# Do NOT share this file or upload it to Git once production values are set.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Container Registry Config
# -----------------------------------------------------------------------------
# The GitHub Username of the developer containing the built Orbis docker images
GHCR_USERNAME=mxhabob

# The version of Orbis to run (e.g., v1.0.0, v1.1.0, or 'stable' for the latest stable build)
ORBIS_VERSION=stable

# -----------------------------------------------------------------------------
# 2. Local Network Setup (School LAN)
# -----------------------------------------------------------------------------
# The local IP address of this school server (run 'ipconfig' to find it, e.g., 192.168.1.100)
SERVER_LAN_IP=localhost

# Allowed domains/origins for CORS security (dashboard and API URLs)
ALLOWED_API_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Better Auth production URL (must point to Hono API port 3002)
# Replace 'localhost' with the actual SERVER_LAN_IP when deploying on LAN
BETTER_AUTH_URL=http://localhost:3002
AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# -----------------------------------------------------------------------------
# 3. Security Secrets (CRITICAL: Change these to long random strings!)
# -----------------------------------------------------------------------------
# Secret key for authentication tokens (e.g., generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=generate_a_secure_long_random_hex_string_here_auth

# Secret key for encrypting school databases (e.g., generate with: openssl rand -hex 32)
ENCRYPTION_SECRET=generate_a_secure_long_random_hex_string_here_encrypt

# -----------------------------------------------------------------------------
# 4. Database Setup (Inside Docker)
# -----------------------------------------------------------------------------
DB_PORT=5432
DB_USER=orbis
DB_PASSWORD=orbis_local_2026
DB_NAME=orbis_db

# -----------------------------------------------------------------------------
# 5. Local S3 File Storage (RustFS Inside Docker)
# -----------------------------------------------------------------------------
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfs_local_2026

# -----------------------------------------------------------------------------
# 6. Third Party Integrations (Optional / Disabled Offline)
# -----------------------------------------------------------------------------
# Sentry error tracking (disable by leaving empty)
SENTRY_DSN=

# Resend email SMTP config (leave empty to log emails to server console instead of sending)
RESEND_API_KEY=
ORBIS_EMAIL_FROM=support@orbisschool.local
