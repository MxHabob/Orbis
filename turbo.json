{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["**/.env", ".env.example"],
  "globalEnv": [
    "ALLOWED_API_ORIGINS",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DATABASE_PRIMARY_URL",
    "DATABASE_URL",
    "FILE_KEY_SECRET",
    "LOG_LEVEL",
    "LOG_PRETTY",
    "MINIO_ROOT_PASSWORD",
    "MINIO_ROOT_USER",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_URL",
    "NODE_ENV",
    "PORT",
    "REDIS_URL",
    "S3_ACCESS_KEY_ID",
    "S3_BUCKET",
    "S3_ENDPOINT_URL",
    "S3_REGION",
    "S3_SECRET_ACCESS_KEY"
  ],
  "ui": "stream",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "next-env.d.ts",
        ".expo/**",
        "dist/**",
        "build/**",
        "lib/**"
      ],
      "passThroughEnv": [
        "ALLOWED_API_ORIGINS",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "DATABASE_PRIMARY_URL",
        "DATABASE_URL",
        "FILE_KEY_SECRET",
        "LOG_LEVEL",
        "LOG_PRETTY",
        "MINIO_ROOT_PASSWORD",
        "MINIO_ROOT_USER",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_URL",
        "NODE_ENV",
        "PORT",
        "REDIS_URL",
        "S3_ACCESS_KEY_ID",
        "S3_BUCKET",
        "S3_ENDPOINT_URL",
        "S3_REGION",
        "S3_SECRET_ACCESS_KEY"
      ]
    },
    "start": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "dev": {
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.example"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": [
        "ALLOWED_API_ORIGINS",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "DATABASE_PRIMARY_URL",
        "DATABASE_URL",
        "FILE_KEY_SECRET",
        "LOG_LEVEL",
        "LOG_PRETTY",
        "MINIO_ROOT_PASSWORD",
        "MINIO_ROOT_USER",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_URL",
        "NODE_ENV",
        "PORT",
        "REDIS_URL",
        "S3_ACCESS_KEY_ID",
        "S3_BUCKET",
        "S3_ENDPOINT_URL",
        "S3_REGION",
        "S3_SECRET_ACCESS_KEY"
      ]
    },
    "jobs": {
      "persistent": true,
      "cache": false
    },
    "format": {},
    "lint": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "tauri:build": {
      "dependsOn": ["^build"],
      "outputs": ["src-tauri/target/release/bundle/**"]
    },
    "tauri:dev": {
      "persistent": true,
      "cache": false
    },
    "tauri:staging": {
      "persistent": true,
      "cache": false
    },
    "tauri:prod": {
      "persistent": true,
      "cache": false
    },
    "tauri:build:staging": {
      "dependsOn": ["^build"],
      "outputs": ["src-tauri/target/release/bundle/**"]
    },
    "tauri:build:prod": {
      "dependsOn": ["^build"],
      "outputs": ["src-tauri/target/release/bundle/**"]
    }
  }
}
