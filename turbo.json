{
  "globalDependencies": ["**/.env", ".env.example"],
  "ui": "stream",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "next-env.d.ts",
        ".expo/**",
        "dist/**",
        "build/**",
        "lib/**"
      ]
    },
    "start": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "dev": {
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.example"],
      "persistent": true,
      "cache": false,
      "env": [
        "APP_ENV",
        "ORBIS_ENV",
        "PORT",
        "JWT_EXPIRY_HOURS",
        "JWT_REFRESH_DAYS",
        "JWT_ACCESS_EXPIRY_HOURS",
        "JWT_REFRESH_EXPIRY_DAYS",
        "PUBLIC_REGISTRATION_ENABLED",
        "LLM_PROVIDER",
        "OLLAMA_URL",
        "OLLAMA_MODEL",
        "CORS_ORIGINS",
        "BIND_HOST",
        "MAX_REQUEST_BYTES",
        "TAURI_DEV_HOST",
        "VITE_API_URL",
        "EXPO_PUBLIC_API_URL"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "JWT_SECRET",
        "GEMINI_API_KEY",
        "OPENAI_API_KEY"
      ]
    },
    "start:tunnel": {
      "persistent": true,
      "cache": false
    },
    "android:device": {
      "cache": false
    },
    "prebuild:clean": {
      "cache": false
    },
    "jobs": {
      "persistent": true,
      "cache": false
    },
    "format": {},
    "lint": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "tauri:build": {
      "dependsOn": ["^build"],
      "outputs": ["src-tauri/target/release/bundle/**"]
    },
    "tauri:dev": {
      "persistent": true,
      "cache": false
    },
    "tauri:staging": {
      "persistent": true,
      "cache": false
    },
    "tauri:prod": {
      "persistent": true,
      "cache": false
    },
    "tauri:build:staging": {
      "dependsOn": ["^build"],
      "outputs": ["src-tauri/target/release/bundle/**"]
    },
    "tauri:build:prod": {
      "dependsOn": ["^build"],
      "outputs": ["src-tauri/target/release/bundle/**"]
    }
  }
}
