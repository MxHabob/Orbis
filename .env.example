# Shared application environment variables used across the app.
# Copy this file to .env (or .env.local) and fill only the values you need.

PORT=3002
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002
ALLOWED_API_ORIGINS=http://localhost:3001

NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_URL=http://localhost:3001

DATABASE_URL=pglite://base_db
DATABASE_PRIMARY_URL=pglite://base_db
REDIS_URL=redis://localhost:6379

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vault
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=your_password_here
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_password_here

FILE_KEY_SECRET=secret
LOG_LEVEL=debug
LOG_PRETTY=true
