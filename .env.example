# Orbis local development environment

# Rust API
APP_ENV=development
PORT=3002
BIND_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:1520,http://localhost:3000
MAX_REQUEST_BYTES=26214400
DATABASE_URL=sqlite://../../orbis.db?mode=rwc

# Authentication
JWT_SECRET=replace-with-a-local-secret-at-least-32-characters
JWT_EXPIRY_HOURS=24
JWT_REFRESH_DAYS=7
PUBLIC_REGISTRATION_ENABLED=true

# Scheduling
SOLVER_SERVICE_URL=http://localhost:8081

# AI
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
GEMINI_API_KEY=

# Desktop development
TAURI_DEV_HOST=
