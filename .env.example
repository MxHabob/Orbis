# =============================================================================
# Orbis — Root Workspace Environment Configuration (.env.example)
# =============================================================================

# Rust Axum Backend
PORT=3000
BIND_HOST=0.0.0.0
APP_ENV=development
CORS_ORIGINS=http://localhost:1520,http://localhost:3000,http://localhost:5173,http://localhost:8081
MAX_REQUEST_BYTES=26214400

# Desktop / Web Frontend
VITE_API_URL=http://localhost:3000
VITE_APP_ENV=development
MULVERSE_API_URL=https://api.mulverse.com
# Generate a unique 32-byte hex value for this server with `openssl rand -hex 32`.
# Keep it stable and secret; changing it makes previously stored Mulverse keys unreadable.
MULVERSE_ORBIS_ENCRYPTION_KEY=

# Mobile directory lookup (Expo embeds EXPO_PUBLIC_* values into the app bundle)
EXPO_PUBLIC_MULVERSE_API_URL=https://api.mulverse.com

# In development, dev:api uses the database selected in the Desktop connection settings.
# Set this only when you intentionally want the API to use a separate development database.
# ORBIS_API_DATABASE_URL=sqlite://orbis-api-dev.db?mode=rwc
# Configure DATABASE_URL in the production service environment, not here.
# DATABASE_URL=postgresql://orbis:password@localhost:5432/orbis_db

# Security & JWT
JWT_SECRET=orbis_dev_super_secret_jwt_key_2026_educational_platform
JWT_EXPIRY_HOURS=24
JWT_REFRESH_DAYS=7
JWT_ACCESS_EXPIRY_HOURS=168
JWT_REFRESH_EXPIRY_DAYS=30
PUBLIC_REGISTRATION_ENABLED=true

# Timefold Solver Sidecar Service
SOLVER_SERVICE_URL=http://localhost:8081
