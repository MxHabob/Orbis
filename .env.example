# =============================================================================
# Orbis Platform — Master Environment Configuration Example (.env.example)
# =============================================================================

# ── 1. Server & Network (Rust API) ───────────────────────────────────────────
APP_ENV=development
PORT=3000
BIND_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:1520,http://localhost:3000,http://localhost:5173,http://localhost:8081
MAX_REQUEST_BYTES=26214400
# Optional development mode override (bypasses auth for local Swagger testing)
# ORBIS_DEV_MODE=true

# ── 2. Database Connection ───────────────────────────────────────────────────
# Default: Leave empty to auto-discover the active Desktop SQLite database (%APPDATA%/com.mulverse.orbis.dev/orbis.db)
# Or specify an explicit SQLite or PostgreSQL connection string:
# DATABASE_URL=sqlite://orbis.db?mode=rwc
# DATABASE_URL=postgresql://orbis:password@localhost:5432/orbis_db
DATABASE_URL=

# ── 3. Authentication & Security ─────────────────────────────────────────────
# Minimum 32 characters in production
JWT_SECRET=orbis_dev_super_secret_jwt_key_2026_educational_platform
JWT_EXPIRY_HOURS=24
JWT_REFRESH_DAYS=7
JWT_ACCESS_EXPIRY_HOURS=168
JWT_REFRESH_EXPIRY_DAYS=30
PUBLIC_REGISTRATION_ENABLED=true

# ── 4. Scheduling & Timetable Solver ─────────────────────────────────────────
SOLVER_SERVICE_URL=http://localhost:8081

# ── 5. AI & Autopilot Engine ─────────────────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── 6. Desktop Application (Tauri / Svelte) ──────────────────────────────────
TAURI_DEV_HOST=
VITE_API_URL=http://localhost:3000

# ── 7. Mobile Application (React Native / Expo) ──────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000
