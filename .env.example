# =============================================================================
# Orbis — Root Workspace Environment Configuration (.env.example)
# =============================================================================

# Rust Axum Backend
PORT=3000
BIND_HOST=0.0.0.0
APP_ENV=development
CORS_ORIGINS=http://localhost:1520,http://localhost:3000,http://localhost:5173,http://localhost:8081
MAX_REQUEST_BYTES=26214400

# Desktop / Web Frontend
VITE_API_URL=http://localhost:3000
VITE_APP_ENV=development

# Database URL (leave empty for automatic SQLite discovery in Desktop AppData)
# DATABASE_URL=sqlite://orbis.db?mode=rwc
# DATABASE_URL=postgresql://orbis:password@localhost:5432/orbis_db

# Security & JWT
JWT_SECRET=orbis_dev_super_secret_jwt_key_2026_educational_platform
JWT_EXPIRY_HOURS=24
JWT_REFRESH_DAYS=7
JWT_ACCESS_EXPIRY_HOURS=168
JWT_REFRESH_EXPIRY_DAYS=30
PUBLIC_REGISTRATION_ENABLED=true

# Timefold Solver Sidecar Service
SOLVER_SERVICE_URL=http://localhost:8081

# AI & LLM Providers
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
GEMINI_API_KEY=
OPENAI_API_KEY=
