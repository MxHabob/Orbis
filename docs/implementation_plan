**مثال Registration مع Process Manager:**
```rust
// svc-lifecycle/src/ops/registration.rs

pub async fn register_student(ctx: &ServiceContext, cmd: RegisterStudentCmd) -> Result<RegistrationResponse, AppError> {
    ctx.permissions.check(&ctx.actor, Permission::EnrollmentWrite).await?;
    
    let settings = ctx.settings.get_registration_settings(&ctx.org_id).await?;
    
    // ── إنشاء Process Manager ──
    let mut process = ProcessState::new("student_registration", &ctx.org_id, &[
        "validate", "create_user", "generate_number", 
        "create_enrollment", "link_guardian", "assign_fees"
    ]);

    // ── Step 1: Validate ──
    process.begin_step("validate")?;
    validation::registration::validate(&cmd, &settings)?;
    if settings.requires_approval {
        process.status = ProcessStatus::AwaitingApproval { /* ... */ };
        save_process(&ctx.db, &process).await?;
        return Err(AppError::ApprovalRequired { /* ... */ });
    }
    process.complete_step("validate", serde_json::json!({"valid": true}))?;

    // ── Step 2: Create User ──
    process.begin_step("create_user")?;
    let user = match create_student_user(&ctx.db, &ctx.org_id, &cmd).await {
        Ok(u) => u,
        Err(e) => {
            process.fail_step("create_user", &e.to_string());
            save_process(&ctx.db, &process).await?;
            return Err(e);
        }
    };
    process.add_compensation("create_user", CompensationAction::DeleteEntity {
        entity_type: "user".into(), id: user.id.clone()
    });
    process.complete_step("create_user", serde_json::to_value(&user)?)?;

    // ── Step 3: Generate Student Number ──
    process.begin_step("generate_number")?;
    let student_number = generate_student_number(&ctx.db, &ctx.org_id, &settings).await?;
    process.complete_step("generate_number", serde_json::json!({"number": &student_number}))?;

    // ── Step 4: Create Enrollment ──
    process.begin_step("create_enrollment")?;
    let enrollment = match create_enrollment(&ctx.db, &ctx.org_id, &user.id, &cmd, &student_number).await {
        Ok(e) => e,
        Err(e) => {
            process.fail_step("create_enrollment", &e.to_string());
            process.compensate(&ctx.db).await?;  // يتراجع عن create_user
            save_process(&ctx.db, &process).await?;
            return Err(e);
        }
    };
    process.add_compensation("create_enrollment", CompensationAction::DeleteEntity {
        entity_type: "enrollment".into(), id: enrollment.id.clone()
    });
    process.complete_step("create_enrollment", serde_json::to_value(&enrollment)?)?;

    // ── Step 5: Link Guardian ──
    process.begin_step("link_guardian")?;
    if let Some(ref guardian_name) = cmd.guardian_name {
        link_guardian(&ctx.db, &ctx.org_id, &user.id, guardian_name, 
                      cmd.guardian_phone.as_deref(), cmd.guardian_relationship.as_deref()).await?;
    }
    process.complete_step("link_guardian", serde_json::json!({"linked": cmd.guardian_name.is_some()}))?;

    // ── Step 6: Assign Fees ──
    process.begin_step("assign_fees")?;
    let fee_ids = if settings.auto_assign_fees {
        match ctx.fee_assigner.assign_mandatory_fees(&ctx.org_id, &enrollment.id, 
                                                      cmd.class_id.as_deref().unwrap_or("")).await {
            Ok(ids) => ids,
            Err(e) => {
                // الرسوم فشلت — لكن لا نتراجع عن التسجيل (optional step)
                tracing::warn!("Fee assignment failed: {}", e);
                vec![]
            }
        }
    } else { vec![] };
    process.complete_step("assign_fees", serde_json::json!({"fee_ids": &fee_ids}))?;

    // ── Process Complete ──
    process.status = ProcessStatus::Completed;
    process.completed_at = Some(chrono::Utc::now().to_rfc3339());

    // Event Sourcing — تاريخ العملية الكاملة
    ctx.event_store.append("registration", &process.id, "registration.completed",
        &serde_json::to_value(&process)?, &ctx.actor, ctx.correlation_id.as_deref()).await?;

    // EventBus + Reactive AI + Plugins
    let event = EventEnvelope {
        event_type: "student.registered".into(),
        entity_id: enrollment.id.clone(),
        org_id: ctx.org_id.clone(),
        actor: ctx.actor.as_str().into(),
        payload: serde_json::to_value(&RegistrationResponse {
            student: user.clone(), enrollment: enrollment.clone(),
            student_number: student_number.clone(), assigned_fee_ids: fee_ids.clone(),
        })?,
        ..Default::default()
    };
    ctx.event_bus.publish(event.clone());
    ctx.reactive.process(&ctx.db, &ctx.org_id, &event).await;
    ctx.plugins.dispatch(&ctx.db, &ctx.org_id, &event).await;

    ctx.audit.log(AuditEntry {
        action: "student.registered", entity_type: "enrollment",
        entity_id: &enrollment.id, actor: &ctx.actor,
        new_data: Some(serde_json::to_value(&process)?),
        ..Default::default()
    }).await?;

    Ok(RegistrationResponse { student: user, enrollment, student_number, assigned_fee_ids: fee_ids })
}
```

