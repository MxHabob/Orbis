### Reactive Pipeline

```rust
// shared-kernel/src/reactive.rs

/// محلل أحداث — يتفاعل مع domain events وينتج insights
#[async_trait]
pub trait EventAnalyzer: Send + Sync {
    fn name(&self) -> &str;
    fn interested_in(&self) -> &[&str];       // ["enrollment.created", "grade.submitted"]
    async fn analyze(
        &self,
        db: &DatabaseConnection,
        org_id: &str,
        event: &EventEnvelope,
    ) -> Vec<DetectedInsight>;
}

/// Reactive Pipeline — يربط EventBus بـ EventAnalyzers
pub struct ReactivePipeline {
    analyzers: Vec<Arc<dyn EventAnalyzer>>,
}

impl ReactivePipeline {
    pub fn new() -> Self { Self { analyzers: vec![] } }
    
    pub fn register(&mut self, analyzer: Arc<dyn EventAnalyzer>) {
        self.analyzers.push(analyzer);
    }
    
    /// يُستدعى بعد كل event — يشغّل المحللات المهتمة
    pub async fn process(&self, db: &DatabaseConnection, org_id: &str, 
                          event: &EventEnvelope) -> Vec<DetectedInsight> {
        let mut insights = vec![];
        for analyzer in &self.analyzers {
            if analyzer.interested_in().contains(&event.event_type.as_str()) {
                let mut result = analyzer.analyze(db, org_id, event).await;
                insights.append(&mut result);
            }
        }
        insights
    }
}
```

### Plugin Architecture

```rust
// shared-kernel/src/plugin.rs

#[async_trait]
pub trait OrbisPlugin: Send + Sync {
    fn name(&self) -> &str;
    fn version(&self) -> &str;
    fn subscribed_events(&self) -> &[&str];
    async fn on_event(&self, db: &DatabaseConnection, org_id: &str, 
                       event: &EventEnvelope) -> Result<(), AppError>;
    fn register_actions(&self) -> Vec<ActionDefinition> { vec![] }
    async fn initialize(&self, db: &DatabaseConnection) -> Result<(), AppError> { Ok(()) }
}

pub struct PluginRegistry {
    plugins: Vec<Arc<dyn OrbisPlugin>>,
}

impl PluginRegistry {
    pub fn new() -> Self { Self { plugins: vec![] } }
    pub fn register(&mut self, plugin: Arc<dyn OrbisPlugin>) { self.plugins.push(plugin); }
    
    /// يُستدعى بعد كل event — يُمرَّر للإضافات المهتمة
    pub async fn dispatch(&self, db: &DatabaseConnection, org_id: &str, 
                           event: &EventEnvelope) {
        for plugin in &self.plugins {
            if plugin.subscribed_events().contains(&event.event_type.as_str()) {
                if let Err(e) = plugin.on_event(db, org_id, event).await {
                    tracing::warn!(plugin = plugin.name(), error = %e, "Plugin error");
                }
            }
        }
    }
}
```

