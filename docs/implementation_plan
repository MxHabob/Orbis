**مثال enrollment.create مع Event Sourcing:**
```rust
pub async fn create(ctx: &ServiceContext, cmd: CreateEnrollmentCmd) -> Result<EnrollmentResponse, AppError> {
    // 1. Permissions
    ctx.permissions.check(&ctx.actor, Permission::EnrollmentWrite).await?;
    
    // 2. Settings-aware validation
    let settings = ctx.settings.get_registration_settings(&ctx.org_id).await?;
    validation::enrollment::validate_create(&ctx.db, &ctx.org_id, &cmd, &settings).await?;
    
    // 3. Policy check
    if ctx.policy.requires_approval("enrollment.create", &ctx.org_id).await? {
        return Err(AppError::ApprovalRequired { /* ... */ });
    }
    
    // 4. Execute
    let enrollment = insert_enrollment(&ctx.db, &ctx.org_id, &cmd).await?;
    
    // 5. Event Sourcing — تاريخ كامل
    ctx.event_store.append(
        "enrollment", &enrollment.id, "enrollment.created",
        &serde_json::to_value(&cmd)?, &ctx.actor, ctx.correlation_id.as_deref(),
    ).await?;
    
    // 6. Audit
    ctx.audit.log(AuditEntry {
        action: "enrollment.created",
        entity_type: "enrollment", entity_id: &enrollment.id,
        actor: &ctx.actor, new_data: Some(serde_json::to_value(&enrollment)?),
        ..Default::default()
    }).await?;
    
    // 7. EventBus → Finance assigns fees + Reactive AI analyzes + Plugins notified
    let event = EventEnvelope {
        event_type: "enrollment.created".into(),
        entity_type: "enrollment".into(),
        entity_id: enrollment.id.clone(),
        org_id: ctx.org_id.clone(),
        actor: ctx.actor.as_str().into(),
        actor_type: ctx.actor.actor_type().into(),
        correlation_id: ctx.correlation_id.clone(),
        payload: serde_json::to_value(&enrollment)?,
        chain_depth: 0,
    };
    ctx.event_bus.publish(event.clone());
    
    // 8. Reactive AI — تحليل لحظي
    let insights = ctx.reactive.process(&ctx.db, &ctx.org_id, &event).await;
    if !insights.is_empty() {
        store_insights(&ctx.db, &ctx.org_id, &insights).await?;
    }
    
    // 9. Plugins
    ctx.plugins.dispatch(&ctx.db, &ctx.org_id, &event).await;
    
    Ok(enrollment)
}
```

