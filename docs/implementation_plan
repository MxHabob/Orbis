pub async fn submit_grade(ctx: &ServiceContext, cmd: SubmitGradeCmd) -> Result<GradeResponse, AppError> {
    ctx.permissions.check(&ctx.actor, Permission::GradeWrite).await?;
    
    // Settings-aware validation
    let grading = ctx.settings.get_grading_settings(&ctx.org_id).await?;
    if cmd.score > grading.max_grade {
        return Err(AppError::validation(format!("الدرجة تتجاوز الحد الأقصى {}", grading.max_grade)));
    }
    if !grading.allow_grade_entry_after_lock {
        check_grade_entry_open(&ctx.db, &cmd.cycle_id).await?;
    }
    
    let grade = insert_grade(&ctx.db, &ctx.org_id, &cmd).await?;
    
    // Event Sourcing — تاريخ الدرجة (من أدخلها؟ هل تم تعديلها؟)
    ctx.event_store.append(
        "grade", &grade.id, "grade.submitted",
        &serde_json::to_value(&cmd)?, &ctx.actor, ctx.correlation_id.as_deref(),
    ).await?;
    
    // EventBus + Reactive AI
    let event = EventEnvelope { event_type: "grade.submitted".into(), /* ... */ };
    ctx.event_bus.publish(event.clone());
    
    // AI يحلل فوراً: هل الطالب معرّض للرسوب؟
    let insights = ctx.reactive.process(&ctx.db, &ctx.org_id, &event).await;
    // ...
    
    Ok(grade)
}
