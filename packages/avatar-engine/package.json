{
  "name": "@orbis/avatar-engine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./native": {
      "types": "./src/native/index.ts",
      "react-native": "./src/native/index.ts",
      "default": "./src/native/index.ts"
    },
    "./avatar.svelte": {
      "svelte": "./src/components/avatar.svelte",
      "default": "./src/components/avatar.svelte"
    }
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.80",
    "react-native-svg": ">=15",
    "svelte": "^5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@orbis/tsconfig": "workspace:*",
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "svelte": "^5.56.1",
    "typescript": "catalog:"
  }
}
