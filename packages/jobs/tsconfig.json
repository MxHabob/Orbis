{
  "extends": "@orbis/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "lib": ["esnext", "dom"],
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@db/*": ["../db/src/*"],
      "@api/*": ["../../apps/api/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}