{
  "name": "@orbis/icons",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "node scripts/audit-icons.mjs --output docs/icon-inventory.json --manifest-output docs/icon-manifest.json",
    "gallery": "node scripts/build-gallery.mjs",
    "test": "node scripts/audit-icons.mjs --self-test"
  },
  "svelte": "./src/svelte/index.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/svelte/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./svelte": {
      "svelte": "./src/svelte/index.ts",
      "import": "./src/svelte/index.ts",
      "default": "./src/svelte/index.ts"
    },
    "./native": {
      "import": "./src/native/index.ts",
      "default": "./src/native/index.ts"
    },
    "./native/Illustrations": {
      "import": "./src/native/Illustrations/index.tsx",
      "default": "./src/native/Illustrations/index.tsx"
    },
    "./svelte/drawings": {
      "svelte": "./src/svelte/drawings/index.ts",
      "import": "./src/svelte/drawings/index.ts",
      "default": "./src/svelte/drawings/index.ts"
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": "*",
    "react-native-svg": ">=13.0.0",
    "svelte": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@orbis/tsconfig": "workspace:*",
    "@types/react": "~19.2.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "svelte": "^5.56.1",
    "typescript": "catalog:"
  }
}
