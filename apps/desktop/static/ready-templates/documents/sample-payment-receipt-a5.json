{
  "version": "2.0",
  "meta": {
    "name": "Sample Payment Receipt",
    "nameAr": "سند قبض تجريبي",
    "documentType": "RECEIPT",
    "entityType": "payment",
    "locale": "ar",
    "pageSetup": {
      "size": "A5",
      "orientation": "portrait",
      "margins": { "top": 10, "bottom": 10, "left": 10, "right": 10 },
