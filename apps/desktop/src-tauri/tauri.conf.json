{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbis",
  "identifier": "com.mulverse.orbis",
  "version": "1.2.2",
  "build": {
    "beforeDevCommand": "bun run --cwd ../web dev",
    "beforeBuildCommand": "bun run --cwd ../.. build:web",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../../web/build"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; frame-src 'self' blob: data:; img-src 'self' asset: https://asset.localhost https://github.com https://*.githubusercontent.com https://7w08qwpcvz.ufs.sh blob: data:; connect-src 'self' https: http://127.0.0.1:* http://localhost:* http://[::1]:*; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": false,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$LOCALAPPDATA/**",
          "$RESOURCE/**",
          "$TEMP/**"
        ]
      },
      "capabilities": [
        "default",
        "desktop-capability",
        "changelog-window"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "release-notes.json"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "dmg": {
        "background": "./images/installer.png"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "sidebarImage": "./images/orbis-installer-sidebar.bmp",
        "installerIcon": "./images/installerico.ico",
        "uninstallerIcon": "./images/installerico.ico"
      }
    },
    "icon": [
      "icons/production/32x32.png",
      "icons/production/128x128.png",
      "icons/production/128x128@2x.png",
      "icons/production/icon.icns",
      "icons/production/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "orbis"
        ]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "dangerousInsecureTransportProtocol": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
