{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbis",
  "identifier": "com.mulverse.orbis",
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true,
      "freezePrototype": false,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "macOS": {
      "dmg": {
        "background": "./images/installer.png"
      }
    },
    "icon": [
      "icons/production/32x32.png",
      "icons/production/128x128.png",
      "icons/production/128x128@2x.png",
      "icons/production/icon.icns",
      "icons/production/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["orbis"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.mulverse.com/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW51c2VkdW51c2VkdW51c2VkdW51c2VkdW51c2VkdW51c2VkdW51c2VkdW51c2Vk"
    }
  }
}
