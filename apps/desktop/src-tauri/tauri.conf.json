{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbis",
  "identifier": "com.mulverse.orbis",
  "version": "1.0.0",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1520",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost https://github.com https://*.githubusercontent.com blob: data:; connect-src 'self' https://api.github.com https://api.mulverse.com https://models.dev; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": false,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$LOCALAPPDATA/**", "$RESOURCE/**", "$TEMP/**"]
      },
      "capabilities": ["default", "desktop-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/solver-service"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "dmg": {
        "background": "./images/installer.png"
      }
    },
    "windows": {
      "nsis": {
        "sidebarImage": "./images/orbis-installer-sidebar.bmp"
      }
    },
    "icon": [
      "icons/production/32x32.png",
      "icons/production/128x128.png",
      "icons/production/128x128@2x.png",
      "icons/production/icon.icns",
      "icons/production/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["orbis"]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://api.mulverse.com/api/v1/public/updates/tauri?product_key=ORBIS&channel=stable&current_version={{current_version}}&target={{target}}&arch={{arch}}"
      ],
      "dangerousInsecureTransportProtocol": false
    }
  }
}
