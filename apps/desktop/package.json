{
  "name": "@orbis/desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --clearScreen false",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "i18n:lint": "bunx @inlang/cli lint",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:staging": "tauri dev --config src-tauri/tauri.staging.conf.json",
    "tauri:prod": "tauri dev",
    "tauri:build:dev": "tauri build --config src-tauri/tauri.dev.conf.json",
    "tauri:build:staging": "tauri build --config src-tauri/tauri.staging.conf.json",
    "tauri:build:prod": "tauri build"
  },
  "dependencies": {
    "@docforge/core": "workspace:*",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.33.0",
    "@orbis/app-store": "workspace:*",
    "@orbis/avatar-engine": "workspace:*",
    "@orbis/location": "workspace:*",
    "@orbis/schemas": "workspace:*",
    "@orbis/sdk": "workspace:*",
    "@orbis/svelte-grid": "workspace:*",
    "@orbis/ui": "workspace:*",
    "@orbis/utils": "workspace:*",
    "@tanstack/svelte-form": "^1.33.5",
    "@tanstack/svelte-query": "^6.1.40",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "~2.4.9",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-global-shortcut": "~2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "@tauri-apps/plugin-upload": "~2.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.18.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.16"
  }
}
