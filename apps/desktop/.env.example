# =============================================================================
# Orbis — Desktop & Web Frontend Configuration (.env.example)
# =============================================================================

# Base URL for Remote HTTP API (used in web browser mode or remote server connection)
VITE_API_URL=http://localhost:3000

# Optional central Orbis API URL used by the shared template library.
# When omitted, the marketplace uses VITE_API_URL.
VITE_ORBIS_MARKETPLACE_API_URL=

# Application Environment (development | production)
VITE_APP_ENV=development
