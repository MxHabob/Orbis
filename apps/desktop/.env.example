# =============================================================================
# Orbis — Desktop & Web Frontend Configuration (.env.example)
# =============================================================================

# Base URL for Remote HTTP API (used in web browser mode or remote server connection)
VITE_API_URL=http://localhost:3000

# Public HTTPS URL for the ready-template catalog JSON (metadata only).
# Each catalog entry points to a separate template JSON file on public storage.
VITE_ORBIS_TEMPLATE_CATALOG_URL=

# Application Environment (development | production)
VITE_APP_ENV=development
