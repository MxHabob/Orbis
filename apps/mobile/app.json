{
  "expo": {
    "name": "Orbis",
    "slug": "Orbis",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "orbis",
    "userInterfaceStyle": "automatic",
    "android": {
      "versionCode": 3,
      "permissions": ["android.permission.ACCESS_LOCAL_NETWORK"],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mxhabob.Orbis"
    },
    "ios": {
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Orbis connects to your school server on the local network.",
        "NSBonjourServices": ["_orbis-api._tcp"],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "plugins": [
      "expo-router",
      ["expo-status-bar", { "style": "dark" }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/android-icon-foreground.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Orbis uses the camera to scan your school's institution QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["ar", "en"],
            "android": ["ar", "en"]
          },
          "supportsRTL": true
        }
      ],
      "expo-web-browser",
      "expo-updates",
      "./plugins/with-android-cleartext-traffic.cjs",
      "./plugins/with-android-window-layout.cjs",
      "./plugins/with-android-release-signing.cjs",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "enablePngCrunchInReleaseBuilds": true
          }
        }
      ],
      ["expo-sqlite", { "useSQLCipher": true }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
