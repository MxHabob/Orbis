{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbis",
  "identifier": "com.mulverse.orbis",
  "version": "1.0.0",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1520",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true,
      "freezePrototype": false,
      "capabilities": ["default", "desktop-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "macOS": {
      "dmg": {
        "background": "./images/installer.png"
      }
    },
    "icon": [
      "icons/production/32x32.png",
      "icons/production/128x128.png",
      "icons/production/128x128@2x.png",
      "icons/production/icon.icns",
      "icons/production/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["orbis"]
      }
    },
    "updater": {
      "pubkey": "dW51c2VkdW51c2VkdW51c2VkdW51c2VkdW51c2VkdW51c2VkdW51c2VkdW51c2Vk",
      "endpoints": ["https://api.mulverse.com/orbis/desktop/update"],
      "createUpdaterArtifacts": true,
      "dangerousInsecureTransportProtocol": true
    }
  }
}
