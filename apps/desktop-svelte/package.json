{
  "name": "@orbis/desktop-svelte",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:dev": "ORBIS_ENV=development tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:staging": "ORBIS_ENV=staging tauri dev --config src-tauri/tauri.staging.conf.json",
    "tauri:prod": "ORBIS_ENV=production tauri dev",
    "tauri:build:dev": "tauri build --config src-tauri/tauri.dev.conf.json",
    "tauri:build:staging": "tauri build --config src-tauri/tauri.staging.conf.json",
    "tauri:build:prod": "tauri build"
  },
  "dependencies": {
    "@docforge/core": "workspace:*",
    "@internationalized/date": "^3.12.0",
    "@orbis/data-grid": "workspace:*",
    "@orbis/desktop-client": "workspace:*",
    "@orbis/location": "workspace:*",
    "@orbis/ui-svelte": "workspace:*",
    "@orbis/utils": "workspace:*",
    "@tanstack/svelte-query": "^5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "~2",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-global-shortcut": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "@tauri-apps/plugin-upload": "~2",
    "lucide-svelte": "^0.460.0",
    "svelte-sonner": "^1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.18.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
