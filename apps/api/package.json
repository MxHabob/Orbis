{
  "name": "@midday/api",
  "packageManager": "bun@1.2.22",
  "scripts": {
    "dev": "TZ=UTC PORT=3002 bun run --hot src/index.ts",
    "jobs": "bun run --hot src/worker.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "find src -name '*.test.ts' -o -name '*.spec.ts' | grep -q . && bun test src || echo 'No tests yet'"
  },
  "exports": {
    "./trpc/routers/_app": "./src/trpc/routers/_app.ts",
    "./ai/types": "./src/ai/types.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@date-fns/tz": "^1.4.1",
    "@hono/mcp": "^0.2.3",
    "@hono/trpc-server": "^0.4.1",
    "@hono/zod-openapi": "^1.1.5",
    "@hono/zod-validator": "^0.7.5",
    "@midday/auth": "workspace:*",
    "@midday/cache": "workspace:*",
    "@midday/db": "workspace:*",
    "@midday/encryption": "workspace:*",
    "@midday/location": "workspace:*",
    "@midday/logger": "workspace:*",
    "@midday/storage": "workspace:*",
    "@midday/jobs": "workspace:*",
    "@midday/utils": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@scalar/hono-api-reference": "^0.9.26",
    "@sindresorhus/slugify": "^3.0.0",
    "@trpc/server": "^11.8.1",
    "camelcase-keys": "^10.0.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "hono": "4.11.4",
    "hono-rate-limiter": "0.4.2",
    "jose": "^6.1.3",
    "nanoid": "^5.1.6",
    "parse-duration": "^2.1.4",
    "pino": "^10.1.1",
    "resend": "^6.5.2",
    "snakecase-keys": "^9.0.2",
    "superjson": "^2.2.6",
    "uuid": "^13.0.0",
    "zod": "^4.1.13",
    "zod-openapi": "^5.4.5"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
}
