{
  "openapi": "3.0.3",
  "info": {
    "title": "orbis-server",
    "description": "",
    "license": { "name": "" },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/organizations": {
      "post": {
        "tags": ["Organization"],
        "operationId": "create_org",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateOrgRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Organization created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrgResponse" }
              }
            }
          },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/organizations/units": {
      "post": {
        "tags": ["Organization"],
        "operationId": "create_org_unit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateOrgUnitRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Organization Unit created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrgUnitResponse" }
              }
            }
          },
          "500": { "description": "Internal server error" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcademicContextResponse": {
        "type": "object",
        "required": ["all_years", "periods", "year_status", "is_read_only"],
        "properties": {
          "all_years": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AcademicYearInfo" }
          },
          "current_year": {
            "allOf": [{ "$ref": "#/components/schemas/AcademicYearInfo" }],
            "nullable": true
          },
          "is_read_only": { "type": "boolean" },
          "periods": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AcademicPeriod" }
          },
          "year_status": { "type": "string" }
        }
      },
      "AcademicPeriod": {
        "type": "object",
        "required": [
          "id",
          "year_id",
          "name",
          "start_date",
          "end_date",
          "period_type",
          "status",
          "is_grade_entry_open",
          "is_enrollment_open"
        ],
        "properties": {
          "end_date": { "type": "string", "format": "date-time" },
          "exam_end": { "type": "string", "nullable": true },
          "exam_start": { "type": "string", "nullable": true },
          "id": { "type": "string", "format": "uuid" },
          "is_enrollment_open": { "type": "integer", "format": "int32" },
          "is_grade_entry_open": { "type": "integer", "format": "int32" },
          "name": { "type": "string" },
          "period_type": { "type": "string" },
          "start_date": { "type": "string", "format": "date-time" },
          "status": { "type": "string" },
          "year_id": { "type": "string", "format": "uuid" }
        }
      },
      "AcademicYear": {
        "type": "object",
        "required": [
          "id",
          "org_id",
          "code",
          "name",
          "start_date",
          "end_date",
          "is_active",
          "is_locked",
          "status"
        ],
        "properties": {
          "code": { "type": "string" },
          "end_date": { "type": "string", "format": "date-time" },
          "id": { "type": "string", "format": "uuid" },
          "is_active": { "type": "boolean" },
          "is_locked": { "type": "integer", "format": "int32" },
          "name": { "type": "string" },
          "name_ar": { "type": "string", "nullable": true },
          "org_id": { "type": "string", "format": "uuid" },
          "start_date": { "type": "string", "format": "date-time" },
          "status": { "type": "string" }
        }
      },
      "AcademicYearInfo": {
        "type": "object",
        "required": ["year", "periods"],
        "properties": {
          "periods": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AcademicPeriod" }
          },
          "year": { "$ref": "#/components/schemas/AcademicYear" }
        }
      },
      "CreateOrgRequest": {
        "type": "object",
        "required": ["name", "slug", "timezone", "locale"],
        "properties": {
          "locale": { "type": "string", "example": "ar-SA" },
          "name": { "type": "string", "example": "Orbis High School" },
          "slug": { "type": "string", "example": "orbis-high" },
          "timezone": { "type": "string", "example": "Asia/Riyadh" }
        }
      },
      "CreateOrgUnitRequest": {
        "type": "object",
        "required": ["org_id", "name", "unit_type", "data_isolation"],
        "properties": {
          "data_isolation": { "type": "string" },
          "name": { "type": "string" },
          "org_id": { "type": "string", "format": "uuid" },
          "parent_id": { "type": "string", "format": "uuid", "nullable": true },
          "unit_type": { "type": "string" }
        }
      },
      "Enrollment": {
        "type": "object",
        "required": [
          "id",
          "student_id",
          "class_id",
          "academic_year_id",
          "status",
          "enrollment_date"
        ],
        "properties": {
          "academic_year_id": { "type": "string", "format": "uuid" },
          "class_id": { "type": "string", "format": "uuid" },
          "enrollment_date": { "type": "string", "format": "date-time" },
          "id": { "type": "string", "format": "uuid" },
          "status": { "type": "string" },
          "student_id": { "type": "string", "format": "uuid" }
        }
      },
      "ExamSession": {
        "type": "object",
        "required": [
          "id",
          "name",
          "start_date",
          "end_date",
          "period_id",
          "is_active",
          "status"
        ],
        "properties": {
          "end_date": { "type": "string", "format": "date-time" },
          "id": { "type": "string", "format": "uuid" },
          "is_active": { "type": "boolean" },
          "name": { "type": "string" },
          "name_ar": { "type": "string", "nullable": true },
          "period_id": { "type": "string", "format": "uuid" },
          "start_date": { "type": "string", "format": "date-time" },
          "status": { "type": "string" }
        }
      },
      "ExamSubject": {
        "type": "object",
        "required": [
          "id",
          "session_id",
          "subject_id",
          "date",
          "max_score",
          "passing_score"
        ],
        "properties": {
          "date": { "type": "string", "format": "date-time" },
          "id": { "type": "string", "format": "uuid" },
          "max_score": { "type": "number", "format": "double" },
          "passing_score": { "type": "number", "format": "double" },
          "session_id": { "type": "string", "format": "uuid" },
          "subject_id": { "type": "string", "format": "uuid" }
        }
      },
      "OrbisError": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "details": { "nullable": true },
          "message": { "type": "string" }
        }
      },
      "OrgResponse": {
        "type": "object",
        "required": ["id", "name", "slug"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "slug": { "type": "string" }
        }
      },
      "OrgUnitResponse": {
        "type": "object",
        "required": ["id", "path", "depth"],
        "properties": {
          "depth": { "type": "integer", "format": "int32" },
          "id": { "type": "string", "format": "uuid" },
          "path": { "type": "string" }
        }
      },
      "Organization": {
        "type": "object",
        "required": ["id", "name", "slug", "timezone", "locale"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "locale": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "timezone": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "org_id",
          "username",
          "email",
          "first_name",
          "last_name",
          "is_active"
        ],
        "properties": {
          "email": { "type": "string" },
          "first_name": { "type": "string" },
          "id": { "type": "string", "format": "uuid" },
          "is_active": { "type": "boolean" },
          "last_name": { "type": "string" },
          "org_id": { "type": "string", "format": "uuid" },
          "username": { "type": "string" }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Organization",
      "description": "Organization management endpoints"
    }
  ]
}
