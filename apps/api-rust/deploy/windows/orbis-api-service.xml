<service>
  <id>OrbisApi</id>
  <name>Orbis API</name>
  <description>Orbis API server for a customer-operated Orbis deployment.</description>
  <executable>%BASE%\orbis-server.exe</executable>
  <workingdirectory>%BASE%</workingdirectory>
  <serviceaccount>
    <user>NT AUTHORITY\LocalService</user>
  </serviceaccount>
  <env name="ORBIS_SERVER_CONFIG_FILE" value="%ProgramData%\Orbis\server.json" />
  <env name="ORBIS_LICENSE_DATA_DIR" value="%ProgramData%\Orbis\license" />
  <logpath>%ProgramData%\Orbis\logs</logpath>
  <log mode="roll" />
  <onfailure action="restart" delay="5 sec" />
  <stoptimeout>30 sec</stoptimeout>
</service>
