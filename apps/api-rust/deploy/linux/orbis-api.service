[Unit]
Description=Orbis API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orbis
Group=orbis
Environment=ORBIS_SERVER_CONFIG_FILE=/etc/orbis/server.json
Environment=ORBIS_LICENSE_DATA_DIR=/var/lib/orbis/license
ExecStart=/opt/orbis/bin/orbis-server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/etc/orbis /var/lib/orbis

[Install]
WantedBy=multi-user.target
