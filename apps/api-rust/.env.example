# =============================================================================
# Orbis — Rust API Local Configuration Example (.env.example)
# =============================================================================

# Application environment (development | production)
APP_ENV=development

# Port on which the Rust Axum API listener runs
PORT=3002

# Database URL.
# SQLite example (default):
DATABASE_URL=sqlite://../../orbis.db?mode=rwc
# PostgreSQL example:
# DATABASE_URL=postgresql://orbis:orbis_local_2026@localhost:5432/orbis_db

# JWT Configuration
JWT_SECRET=orbis_super_secure_secret_key_2026
JWT_EXPIRY_HOURS=24
JWT_REFRESH_DAYS=7

# Timefold Solver Sidecar (optional — leave empty to disable auto-scheduling)
SOLVER_SERVICE_URL=http://localhost:8081
