# =============================================================================
# Orbis — Rust API Local Configuration Example (.env.example)
# =============================================================================

# Application environment (development | production)
APP_ENV=development

# Port on which the Rust Axum API listener runs
PORT=3000
BIND_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:1520,http://localhost:3000,http://localhost:5173,http://localhost:8081
MAX_REQUEST_BYTES=26214400

# Database URL.
# Default: Leave empty to auto-discover active Desktop SQLite database (%APPDATA%/com.mulverse.orbis.dev/orbis.db)
# SQLite explicit: DATABASE_URL=sqlite://orbis.db?mode=rwc
# PostgreSQL example: DATABASE_URL=postgresql://orbis:password@localhost:5432/orbis_db
# DATABASE_URL=

# JWT Configuration
JWT_SECRET=orbis_dev_super_secret_jwt_key_2026_educational_platform
JWT_EXPIRY_HOURS=24
JWT_REFRESH_DAYS=7
JWT_ACCESS_EXPIRY_HOURS=168
JWT_REFRESH_EXPIRY_DAYS=30
PUBLIC_REGISTRATION_ENABLED=true

# Timefold Solver Sidecar (optional — leave empty to disable auto-scheduling)
SOLVER_SERVICE_URL=http://localhost:8081

# AI Configuration
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
GEMINI_API_KEY=
OPENAI_API_KEY=
