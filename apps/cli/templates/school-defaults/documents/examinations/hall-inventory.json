{
  "version": "1.0",
  "meta": { "name": "Exam Hall Inventory", "nameAr": "جرد قاعات الاختبار", "documentType": "EXAM_REGISTER", "entityType": "exam_session", "locale": "ar", "pageSetup": { "size": "A4", "orientation": "landscape", "margins": { "top": 14, "bottom": 14, "left": 14, "right": 14 }, "unit": "mm" } },
  "variables": {},
  "assets": { "yemenStateEmblem": { "assetId": "orbis.yemen.state-emblem", "type": "logo" } },
  "root": { "type": "Page", "id": "hall-inventory-page", "children": [
    { "type": "Header", "id": "standard-header", "props": { "height": 22 }, "children": [ { "type": "Image", "id": "header-emblem", "props": { "assetRef": "yemenStateEmblem", "position": { "x": 138, "y": 2, "width": 18, "height": 16 }, "width": 18, "height": 16, "fit": "contain" } }, { "type": "Text", "id": "header-school-name", "props": { "content": "{{organization.nameAr | default:'اسم المدرسة'}}", "position": { "x": 20, "y": 6, "width": 250, "height": 7 }, "fontSize": 12, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } } ] },
    { "type": "Text", "id": "title", "props": { "content": "جرد قاعات الاختبار\n{{session.name}} | {{session.academicYear}}", "position": { "x": 20, "y": 30, "width": 250, "height": 16 }, "fontSize": 15, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.3 } },
    { "type": "Repeater", "id": "halls", "props": { "dataSource": "halls", "itemVariable": "hall", "layout": "vertical", "gap": 1 }, "children": [ { "type": "Text", "id": "hall-row", "props": { "content": "{{hall.name}} | السعة: {{hall.capacity}} | المبنى: {{hall.building}} | الدور: {{hall.floor}}", "position": { "x": 20, "y": 55, "width": 250, "height": 7 }, "fontSize": 10, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.2 } } ] },
    { "type": "Text", "id": "totals", "props": { "content": "إجمالي القاعات: {{totalHalls}}", "position": { "x": 20, "y": 250, "width": 250, "height": 8 }, "fontSize": 11, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "start", "direction": "rtl", "lineHeight": 1.2 } },
    { "type": "Footer", "id": "standard-footer", "props": { "height": 12, "showPageNumber": true, "pageNumberFormat": "صفحة {{page}} من {{total}}" }, "children": [ { "type": "Text", "id": "footer-content", "props": { "content": "{{organization.nameAr | default:'اسم المدرسة'}}  |  صفحة {{page}} من {{total}}", "position": { "x": 20, "y": 275, "width": 250, "height": 6 }, "fontSize": 8, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } } ] }
  ] }
}
