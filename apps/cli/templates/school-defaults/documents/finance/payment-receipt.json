{
  "version": "1.0",
  "meta": {
    "name": "Payment Receipt",
    "nameAr": "سند قبض",
    "documentType": "RECEIPT",
    "entityType": "payment",
    "locale": "ar",
    "pageSetup": {
      "size": "A5",
      "orientation": "portrait",
      "margins": { "top": 10, "bottom": 10, "left": 10, "right": 10 },
      "unit": "mm"
    }
  },
  "variables": {},
  "assets": { "yemenStateEmblem": { "assetId": "orbis.yemen.state-emblem", "type": "logo" } },
  "root": {
    "type": "Page",
    "id": "payment-receipt-page",
    "children": [
      { "type": "Header", "id": "standard-header", "props": { "height": 18 }, "children": [
        { "type": "Image", "id": "header-emblem", "props": { "assetRef": "yemenStateEmblem", "position": { "x": 64, "y": 2, "width": 14, "height": 13 }, "width": 14, "height": 13, "fit": "contain" } },
        { "type": "Text", "id": "header-school-name", "props": { "content": "{{organization.nameAr | default:'اسم المدرسة'}}", "position": { "x": 10, "y": 5, "width": 128, "height": 6 }, "fontSize": 11, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } }
      ] },
      { "type": "Text", "id": "receipt-school", "props": { "content": "{{organization.nameAr | default:'اسم المدرسة'}}", "position": { "x": 10, "y": 12, "width": 128, "height": 8 }, "fontSize": 16, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "receipt-title", "props": { "content": "سند قبض", "position": { "x": 10, "y": 26, "width": 128, "height": 8 }, "fontSize": 15, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "receipt-number", "props": { "content": "رقم السند: {{receiptNumber | default:'غير محدد'}}", "position": { "x": 12, "y": 45, "width": 124, "height": 7 }, "fontSize": 10, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "receipt-payer", "props": { "content": "استلمنا من: {{payerName | default:'غير محدد'}}", "position": { "x": 12, "y": 58, "width": 124, "height": 7 }, "fontSize": 11, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.3 } },
      { "type": "Text", "id": "receipt-amount", "props": { "content": "المبلغ: {{amount | number:'0.00'}} {{currency}}", "position": { "x": 12, "y": 73, "width": 124, "height": 9 }, "fontSize": 13, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "start", "direction": "rtl", "lineHeight": 1.3 } },
      { "type": "Text", "id": "receipt-method", "props": { "content": "طريقة الدفع: {{method}}    التاريخ: {{paidAt | date:'yyyy/MM/dd'}}", "position": { "x": 12, "y": 90, "width": 124, "height": 8 }, "fontSize": 10, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.3 } },
      { "type": "Text", "id": "receipt-notes", "props": { "content": "ملاحظات: {{notes | default:'لا يوجد'}}", "position": { "x": 12, "y": 108, "width": 124, "height": 14 }, "fontSize": 10, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.3 } },
      { "type": "Text", "id": "receipt-signature", "props": { "content": "المستلم: ____________________", "position": { "x": 12, "y": 170, "width": 124, "height": 8 }, "fontSize": 10, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Footer", "id": "standard-footer", "props": { "height": 12, "showPageNumber": true, "pageNumberFormat": "صفحة {{page}} من {{total}}" }, "children": [
        { "type": "Text", "id": "footer-content", "props": { "content": "{{organization.nameAr | default:'اسم المدرسة'}}  |  صفحة {{page}} من {{total}}", "position": { "x": 10, "y": 190, "width": 128, "height": 6 }, "fontSize": 8, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } }
      ] }
    ]
  }
}
