{
  "version": "1.0",
  "meta": { "name": "Staff ID Card", "nameAr": "بطاقة هوية الموظف", "documentType": "ID_CARD", "entityType": "user", "locale": "ar", "pageSetup": { "size": "ID_CARD", "orientation": "landscape", "margins": { "top": 3, "bottom": 3, "left": 3, "right": 3 }, "unit": "mm" } },
  "variables": {},
  "assets": { "org-fallback-logo": { "assetId": "orbis-feedback", "type": "logo" } },
  "root": { "type": "Page", "id": "staff-id-card-page", "children": [
    { "type": "Header", "id": "standard-header", "props": { "height": 10 }, "children": [ { "type": "Image", "id": "organization-logo", "props": { "assetRef": "org-fallback-logo", "src": "{{org_logo_url}}", "position": { "x": 38, "y": 1, "width": 10, "height": 8 }, "width": 10, "height": 8, "fit": "contain" } }, { "type": "Text", "id": "organization-name", "props": { "content": "{{org_name | default:'اسم المنظمة'}}", "position": { "x": 4, "y": 3, "width": 77, "height": 5 }, "fontSize": 7, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.1 } } ] },
    { "type": "Text", "id": "card-title", "props": { "content": "بطاقة موظف", "position": { "x": 5, "y": 15, "width": 76, "height": 6 }, "fontSize": 9, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.1 } },
    { "type": "Text", "id": "staff-name", "props": { "content": "{{nameAr | default:fullName}}", "position": { "x": 5, "y": 25, "width": 76, "height": 6 }, "fontSize": 8, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.1 } },
    { "type": "Text", "id": "staff-details", "props": { "content": "الدور: {{primaryRole}}\nالهاتف: {{phone}}", "position": { "x": 7, "y": 34, "width": 72, "height": 10 }, "fontSize": 7, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
    { "type": "Barcode", "id": "staff-barcode", "props": { "data": "{{id}}", "format": "code128", "position": { "x": 22, "y": 45, "width": 42, "height": 7 }, "height": 7, "showText": false } },
    { "type": "Footer", "id": "standard-footer", "props": { "height": 5, "showPageNumber": false }, "children": [ { "type": "Text", "id": "footer-content", "props": { "content": "{{org_name | default:'اسم المنظمة'}}", "position": { "x": 5, "y": 51, "width": 76, "height": 3 }, "fontSize": 5, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.1 } } ] }
  ] }
}
