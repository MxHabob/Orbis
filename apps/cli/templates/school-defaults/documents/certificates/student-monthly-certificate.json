{
  "version": "1.0",
  "meta": {
    "name": "Student Monthly Certificate",
    "nameAr": "الشهادة الشهرية للطالب",
    "documentType": "CERTIFICATE",
    "entityType": "report_card",
    "locale": "ar",
    "pageSetup": {
      "size": "A5",
      "orientation": "portrait",
      "margins": { "top": 10, "bottom": 8, "left": 10, "right": 10 },
      "unit": "mm"
    }
  },
  "variables": {},
  "assets": { "yemenStateEmblem": { "assetId": "orbis.yemen.state-emblem", "type": "logo" } },
  "root": {
    "type": "Page",
    "id": "monthly-certificate-page",
    "children": [
      { "type": "Shape", "id": "page-border", "props": { "shapeType": "rectangle", "position": { "x": 6, "y": 6, "width": 136, "height": 198 }, "fill": "#ffffff", "stroke": "#777777", "strokeWidth": 0.4 } },
      { "type": "Image", "id": "organization-logo", "props": { "src": "{{organization.logo}}", "position": { "x": 120, "y": 10, "width": 18, "height": 15 }, "width": 18, "height": 15, "fit": "contain", "layer": "front" } },
      { "type": "Image", "id": "state-emblem", "props": { "assetRef": "yemenStateEmblem", "position": { "x": 65, "y": 9, "width": 18, "height": 16 }, "width": 18, "height": 16, "fit": "contain", "layer": "front" } },
      { "type": "Text", "id": "ministry", "props": { "content": "الجمهورية اليمنية\nوزارة التربية والتعليم\nمكتب التربية والتعليم", "position": { "x": 8, "y": 10, "width": 50, "height": 18 }, "fontSize": 7, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "school-header", "props": { "content": "{{organization.nameAr | default:'اسم المدرسة'}}\nالعام الدراسي: {{academicYear | default:'2023/2024'}}", "position": { "x": 86, "y": 26, "width": 52, "height": 12 }, "fontSize": 7, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "report-title", "props": { "content": "التقرير الشهري للطالب", "position": { "x": 20, "y": 30, "width": 108, "height": 8 }, "fontSize": 12, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Shape", "id": "student-info-rule", "props": { "shapeType": "line", "position": { "x": 10, "y": 45, "width": 128, "height": 0 }, "stroke": "#777777", "strokeWidth": 0.5 } },
      { "type": "Text", "id": "student-name", "props": { "content": "اسم الطالب/ة: {{student.nameAr | default:student.fullName}}", "position": { "x": 72, "y": 48, "width": 62, "height": 6 }, "fontSize": 8, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "start", "direction": "rtl", "lineHeight": 1.1 } },
      { "type": "Text", "id": "student-id", "props": { "content": "الرقم الأكاديمي: {{student.nationalId | default:'غير متوفر'}}", "position": { "x": 10, "y": 48, "width": 58, "height": 6 }, "fontSize": 7, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.1 } },
      { "type": "Text", "id": "student-class", "props": { "content": "الفترة: {{periodName}}", "position": { "x": 72, "y": 57, "width": 62, "height": 6 }, "fontSize": 7, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.1 } },
      { "type": "Text", "id": "student-type", "props": { "content": "الصف: {{student.classNameAr | default:'ــــــــــــ'}}", "position": { "x": 10, "y": 57, "width": 58, "height": 6 }, "fontSize": 7, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.1 } },
      { "type": "Table", "id": "monthly-subject-table", "props": { "dataSource": "subjects", "position": { "x": 10, "y": 66, "width": 128, "height": 100 }, "columns": [
        { "id": "subject", "header": "المادة", "field": "subjectName", "width": "45%", "alignment": "right" },
        { "id": "score", "header": "الدرجة", "field": "totalScore", "width": "25%", "alignment": "center", "format": "number:2" },
        { "id": "grade", "header": "التقدير", "field": "gradeLabel", "width": "30%", "alignment": "center" }
      ], "showHeader": true, "showTotals": false, "repeatingHeader": true, "style": { "borderColor": "#555555", "borderWidth": 0.4, "headerBgColor": "#dddddd", "fontSize": 7, "rowHeight": 6, "padding": 1 } } },
      { "type": "Repeater", "id": "monthly-subjects", "props": { "dataSource": "subjects", "itemVariable": "subject", "layout": "vertical", "gap": 0 }, "children": [
        { "type": "Shape", "id": "subject-row-line", "props": { "shapeType": "line", "position": { "x": 10, "y": 73, "width": 128, "height": 0 }, "stroke": "#999999", "strokeWidth": 0.25 } },
        { "type": "Text", "id": "subject-row", "props": { "content": "{{subject.subjectName}}        {{subject.totalScore | number:'0.00'}}        {{subject.gradeLabel}}", "position": { "x": 12, "y": 75, "width": 124, "height": 6 }, "fontSize": 7, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.1 } }
      ] },
      { "type": "Shape", "id": "table-header-fill", "props": { "shapeType": "rectangle", "position": { "x": 10, "y": 66, "width": 128, "height": 7 }, "fill": "#dddddd", "stroke": "#555555", "strokeWidth": 0.35 } },
      { "type": "Text", "id": "table-header", "props": { "content": "المادة                 الدرجة                 التقدير", "position": { "x": 12, "y": 67, "width": 124, "height": 5 }, "fontSize": 7, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.1 } },
      { "type": "Shape", "id": "summary-fill", "props": { "shapeType": "rectangle", "position": { "x": 10, "y": 170, "width": 128, "height": 13 }, "fill": "#dddddd", "stroke": "#999999", "strokeWidth": 0.3 } },
      { "type": "Text", "id": "summary", "props": { "content": "المجموع: {{overallGpa | number:'0.00'}}    المواد: {{totalSubjects}}    الناجح: {{passedSubjects}}", "position": { "x": 12, "y": 174, "width": 124, "height": 6 }, "fontSize": 7, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.1 } },
      { "type": "Text", "id": "result", "props": { "content": "النتيجة: {{overallResult | default:'ناجح'}}    الترتيب: {{rankInClass | default:'ــــــــ'}}", "position": { "x": 12, "y": 185, "width": 124, "height": 7 }, "fontSize": 8, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.1 } },
      { "type": "Text", "id": "parent-signature", "props": { "content": "ملاحظات ولي الأمر", "position": { "x": 10, "y": 194, "width": 40, "height": 7 }, "fontSize": 6, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.1 } },
      { "type": "Text", "id": "school-signature", "props": { "content": "وكيل المدرسة", "position": { "x": 54, "y": 194, "width": 40, "height": 7 }, "fontSize": 6, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.1 } },
      { "type": "Text", "id": "principal-signature", "props": { "content": "إدارة المدرسة", "position": { "x": 98, "y": 194, "width": 40, "height": 7 }, "fontSize": 6, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.1 } },
      { "type": "Footer", "id": "standard-footer", "props": { "height": 6, "showPageNumber": true, "pageNumberFormat": "صفحة {{page}} من {{total}}" }, "children": [] }
    ]
  }
}
