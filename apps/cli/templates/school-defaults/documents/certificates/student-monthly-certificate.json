{
  "version": "1.0",
  "meta": {
    "name": "Student Monthly Certificate",
    "nameAr": "الشهادة الشهرية للطالب",
    "documentType": "CERTIFICATE",
    "entityType": "report_card",
    "locale": "ar",
    "pageSetup": {
      "size": "A4",
      "orientation": "portrait",
      "margins": { "top": 20, "bottom": 20, "left": 18, "right": 18 },
      "unit": "mm"
    }
  },
  "variables": {},
  "assets": { "yemenStateEmblem": { "assetId": "orbis.yemen.state-emblem", "type": "logo" } },
  "root": {
    "type": "Page",
    "id": "monthly-certificate-page",
    "children": [
      { "type": "Shape", "id": "page-border", "props": { "shapeType": "rectangle", "position": { "x": 8, "y": 8, "width": 194, "height": 281 }, "fill": "#ffffff", "stroke": "#777777", "strokeWidth": 0.4 } },
      { "type": "Image", "id": "organization-logo", "props": { "src": "{{organization.logo}}", "position": { "x": 171, "y": 13, "width": 24, "height": 20 }, "width": 24, "height": 20, "fit": "contain", "layer": "front" } },
      { "type": "Image", "id": "state-emblem", "props": { "assetRef": "yemenStateEmblem", "position": { "x": 93, "y": 11, "width": 24, "height": 22 }, "width": 24, "height": 22, "fit": "contain", "layer": "front" } },
      { "type": "Text", "id": "ministry", "props": { "content": "الجمهورية اليمنية\nوزارة التربية والتعليم\nمكتب التربية والتعليم", "position": { "x": 12, "y": 12, "width": 72, "height": 24 }, "fontSize": 8, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.25 } },
      { "type": "Text", "id": "school-header", "props": { "content": "{{organization.nameAr | default:'اسم المدرسة'}}\nالعام الدراسي: {{academicYear | default:'2023/2024'}}", "position": { "x": 120, "y": 35, "width": 76, "height": 15 }, "fontSize": 9, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.3 } },
      { "type": "Text", "id": "report-title", "props": { "content": "التقرير الشهري للطالب", "position": { "x": 30, "y": 42, "width": 140, "height": 10 }, "fontSize": 16, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Shape", "id": "student-info-rule", "props": { "shapeType": "line", "position": { "x": 15, "y": 61, "width": 180, "height": 0 }, "stroke": "#777777", "strokeWidth": 0.5 } },
      { "type": "Text", "id": "student-name", "props": { "content": "اسم الطالب/ة: {{student.nameAr | default:student.fullName}}", "position": { "x": 102, "y": 65, "width": 88, "height": 8 }, "fontSize": 10, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "start", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "student-id", "props": { "content": "الرقم الأكاديمي: {{student.nationalId | default:'غير متوفر'}}", "position": { "x": 15, "y": 65, "width": 82, "height": 8 }, "fontSize": 9, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "student-class", "props": { "content": "الفترة: {{periodName}}", "position": { "x": 102, "y": 76, "width": 88, "height": 8 }, "fontSize": 9, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "student-type", "props": { "content": "الصف: {{student.classNameAr | default:'ــــــــــــ'}}", "position": { "x": 15, "y": 76, "width": 82, "height": 8 }, "fontSize": 9, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Table", "id": "monthly-subject-table", "props": { "dataSource": "subjects", "position": { "x": 15, "y": 86, "width": 180, "height": 140 }, "columns": [
        { "id": "subject", "header": "المادة", "field": "subjectName", "width": "45%", "alignment": "right" },
        { "id": "score", "header": "الدرجة", "field": "totalScore", "width": "25%", "alignment": "center", "format": "number:2" },
        { "id": "grade", "header": "التقدير", "field": "gradeLabel", "width": "30%", "alignment": "center" }
      ], "showHeader": true, "showTotals": false, "repeatingHeader": true, "style": { "borderColor": "#555555", "borderWidth": 0.4, "headerBgColor": "#dddddd", "fontSize": 9, "rowHeight": 8, "padding": 1 } } },
      { "type": "Repeater", "id": "monthly-subjects", "props": { "dataSource": "subjects", "itemVariable": "subject", "layout": "vertical", "gap": 0 }, "children": [
        { "type": "Shape", "id": "subject-row-line", "props": { "shapeType": "line", "position": { "x": 15, "y": 93, "width": 180, "height": 0 }, "stroke": "#999999", "strokeWidth": 0.25 } },
        { "type": "Text", "id": "subject-row", "props": { "content": "{{subject.subjectName}}        {{subject.totalScore | number:'0.00'}}        {{subject.gradeLabel}}", "position": { "x": 18, "y": 95, "width": 174, "height": 8 }, "fontSize": 9, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.2 } }
      ] },
      { "type": "Shape", "id": "table-header-fill", "props": { "shapeType": "rectangle", "position": { "x": 15, "y": 86, "width": 180, "height": 8 }, "fill": "#dddddd", "stroke": "#555555", "strokeWidth": 0.35 } },
      { "type": "Text", "id": "table-header", "props": { "content": "المادة                         الدرجة                         التقدير", "position": { "x": 18, "y": 87, "width": 174, "height": 6 }, "fontSize": 8, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.1 } },
      { "type": "Shape", "id": "summary-fill", "props": { "shapeType": "rectangle", "position": { "x": 15, "y": 235, "width": 180, "height": 18 }, "fill": "#dddddd", "stroke": "#999999", "strokeWidth": 0.3 } },
      { "type": "Text", "id": "summary", "props": { "content": "المجموع النهائي للدرجات: {{overallGpa | number:'0.00'}}        عدد المواد: {{totalSubjects}}        الناجح: {{passedSubjects}}", "position": { "x": 19, "y": 240, "width": 172, "height": 8 }, "fontSize": 9, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "result", "props": { "content": "النتيجة النهائية: {{overallResult | default:'ناجح'}}       الترتيب: {{rankInClass | default:'ــــــــ'}}", "position": { "x": 20, "y": 258, "width": 170, "height": 9 }, "fontSize": 10, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "parent-signature", "props": { "content": "ملاحظات ولي الأمر", "position": { "x": 20, "y": 270, "width": 58, "height": 12 }, "fontSize": 8, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "school-signature", "props": { "content": "وكيل المدرسة", "position": { "x": 80, "y": 270, "width": 45, "height": 12 }, "fontSize": 8, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "principal-signature", "props": { "content": "إدارة المدرسة", "position": { "x": 135, "y": 270, "width": 55, "height": 12 }, "fontSize": 8, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Footer", "id": "standard-footer", "props": { "height": 8, "showPageNumber": true, "pageNumberFormat": "صفحة {{page}} من {{total}}" }, "children": [] }
    ]
  }
}
