{
  "version": "1.0",
  "meta": {
    "name": "Student Term Certificate",
    "nameAr": "شهادة الطالب الفصلية",
    "documentType": "CERTIFICATE",
    "entityType": "term_certificate",
    "locale": "ar",
    "pageSetup": {
      "size": "A4",
      "orientation": "portrait",
      "margins": { "top": 20, "bottom": 20, "left": 18, "right": 18 },
      "unit": "mm"
    }
  },
  "variables": {},
  "assets": { "yemenStateEmblem": { "assetId": "orbis.yemen.state-emblem", "type": "logo" } },
  "root": {
    "type": "Page",
    "id": "term-certificate-page",
    "children": [
      { "type": "Header", "id": "standard-header", "props": { "height": 22 }, "children": [
        { "type": "Image", "id": "header-emblem", "props": { "assetRef": "yemenStateEmblem", "position": { "x": 97, "y": 2, "width": 16, "height": 16 }, "width": 16, "height": 16, "fit": "contain" } },
        { "type": "Text", "id": "header-school-name", "props": { "content": "{{organization.nameAr | default:'اسم المدرسة'}}", "position": { "x": 18, "y": 6, "width": 174, "height": 7 }, "fontSize": 12, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } }
      ] },
      { "type": "Text", "id": "certificate-school", "props": { "content": "{{organization.nameAr | default:'اسم المدرسة'}}", "position": { "x": 18, "y": 25, "width": 174, "height": 10 }, "fontSize": 20, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "certificate-title", "props": { "content": "شهادة الطالب الفصلية", "position": { "x": 18, "y": 48, "width": 174, "height": 10 }, "fontSize": 18, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "certificate-student", "props": { "content": "تشهد المدرسة بأن الطالب/ة: {{student.nameAr | default:student.fullName}}", "position": { "x": 25, "y": 78, "width": 160, "height": 10 }, "fontSize": 13, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.4 } },
      { "type": "Text", "id": "certificate-term", "props": { "content": "قد أتم/ت متطلبات {{termName}} بنجاح", "position": { "x": 25, "y": 98, "width": 160, "height": 10 }, "fontSize": 13, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.4 } },
      { "type": "Text", "id": "certificate-result", "props": { "content": "المجموع: {{termTotal | number:'0.00'}}    أعمال السنة: {{totalCoursework | number:'0.00'}}    الاختبار: {{totalExam | number:'0.00'}}", "position": { "x": 25, "y": 125, "width": 160, "height": 12 }, "fontSize": 11, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.4 } },
      { "type": "Text", "id": "certificate-signature", "props": { "content": "مدير/ة المدرسة\n{{organization.name | default:'Orbis'}}", "position": { "x": 25, "y": 235, "width": 160, "height": 16 }, "fontSize": 11, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.4 } },
      { "type": "Footer", "id": "standard-footer", "props": { "height": 12, "showPageNumber": true, "pageNumberFormat": "صفحة {{page}} من {{total}}" }, "children": [
        { "type": "Text", "id": "footer-content", "props": { "content": "{{organization.nameAr | default:'اسم المدرسة'}}  |  صفحة {{page}} من {{total}}", "position": { "x": 18, "y": 265, "width": 174, "height": 6 }, "fontSize": 8, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } }
      ] }
    ]
  }
}
