{
"version": "1.0",

"meta": {
"name": "Master Template",
"nameAr": "القالب الرئيسي",
"documentType": "MASTER",
"entityType": "system",
"locale": "en",
"pageSetup": {
"size": "A4",
"orientation": "portrait",
"margins": {
"top": 20,
"bottom": 20,
"left": 20,
"right": 20
},
"unit": "mm"
}
},

"variables": {
"org_name": {
"type": "string",
"required": false
}
},

"assets": {},

"root": {
"type": "Page",
"id": "master-template-page",
"children": [
  {
    "type": "Header",
    "id": "master-header",
    "props": {
      "height": 20
    },
    "children": [

      {
        "type": "Text",
        "id": "organization-name",
        "props": {
          "content": "{{org_name}}",
          "position": {
            "x": 20,
            "y": 6,
            "width": 170,
            "height": 8
          },
          "fontSize": 12,
          "fontFamily": "Arial",
          "fontWeight": "bold",
          "textAlign": "center",
          "direction": "ltr",
          "lineHeight": 1.2
        }
      }

    ]
  },

  {
    "type": "Text",
    "id": "master-template-content",
    "props": {
      "content": "This is a master template.",
      "position": {
        "x": 20,
        "y": 40,
        "width": 170,
        "height": 10
      },
      "fontSize": 12,
      "fontFamily": "Arial",
      "fontWeight": "normal",
      "textAlign": "left",
      "direction": "ltr",
      "lineHeight": 1.2
    }
  },

  {
    "type": "Footer",
    "id": "master-footer",
    "props": {
      "height": 15,
      "showPageNumber": false
    },
    "children": [

      {
        "type": "Text",
        "id": "footer-content",
        "props": {
          "content": "Generated by Orbis System",
          "position": {
            "x": 20,
            "y": 275,
            "width": 170,
            "height": 6
          },
          "fontSize": 8,
          "fontFamily": "Arial",
          "fontWeight": "normal",
          "textAlign": "center",
          "direction": "ltr",
          "lineHeight": 1.2
        }
      }

    ]
  }

]
}
}
