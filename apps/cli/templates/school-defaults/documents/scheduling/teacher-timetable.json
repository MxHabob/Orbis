{
  "version": "1.0",
  "meta": {
    "name": "Teacher Timetable",
    "nameAr": "الجدول الدراسي للمدرس",
    "documentType": "SCHEDULE",
    "entityType": "teacher_schedule",
    "locale": "ar",
    "pageSetup": { "size": "A4", "orientation": "landscape", "margins": { "top": 14, "bottom": 14, "left": 14, "right": 14 }, "unit": "mm" }
  },
  "variables": {},
  "assets": { "yemenStateEmblem": { "assetId": "orbis.yemen.state-emblem", "type": "logo" } },
  "root": {
    "type": "Page",
    "id": "teacher-timetable-page",
    "children": [
      { "type": "Header", "id": "standard-header", "props": { "height": 22 }, "children": [
        { "type": "Image", "id": "header-emblem", "props": { "assetRef": "yemenStateEmblem", "position": { "x": 138, "y": 2, "width": 18, "height": 16 }, "width": 18, "height": 16, "fit": "contain" } },
        { "type": "Text", "id": "header-school-name", "props": { "content": "{{organization.nameAr | default:'اسم المدرسة'}}", "position": { "x": 20, "y": 6, "width": 250, "height": 7 }, "fontSize": 12, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } }
      ] },
      { "type": "Text", "id": "title", "props": { "content": "الجدول الدراسي للمدرس: {{teacher.nameAr | default:teacher.name}}", "position": { "x": 20, "y": 30, "width": 250, "height": 9 }, "fontSize": 16, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "period", "props": { "content": "{{periodName}}", "position": { "x": 20, "y": 43, "width": 250, "height": 7 }, "fontSize": 11, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Repeater", "id": "teacher-lessons", "props": { "dataSource": "lessons", "itemVariable": "lesson", "layout": "vertical", "gap": 1 }, "children": [
        { "type": "Text", "id": "lesson-row", "props": { "content": "{{lesson.dayName}} | {{lesson.startTime}} - {{lesson.endTime}} | {{lesson.subjectNameAr | default:lesson.subjectName}} | {{lesson.classNameAr | default:lesson.className}} | {{lesson.roomName}}", "position": { "x": 20, "y": 58, "width": 250, "height": 7 }, "fontSize": 10, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.2 } }
      ] },
      { "type": "Footer", "id": "standard-footer", "props": { "height": 12, "showPageNumber": true, "pageNumberFormat": "صفحة {{page}} من {{total}}" }, "children": [
        { "type": "Text", "id": "footer-content", "props": { "content": "{{organization.nameAr | default:'اسم المدرسة'}}  |  صفحة {{page}} من {{total}}", "position": { "x": 20, "y": 185, "width": 250, "height": 6 }, "fontSize": 8, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } }
      ] }
    ]
  }
}
