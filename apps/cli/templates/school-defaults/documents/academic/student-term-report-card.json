{
  "version": "1.0",
  "meta": {
    "name": "Student Term Report Card",
    "nameAr": "كشف درجات الطالب للفصل الدراسي",
    "documentType": "REPORT",
    "entityType": "report_card",
    "locale": "ar",
    "pageSetup": {
      "size": "A4",
      "orientation": "portrait",
      "margins": { "top": 14, "bottom": 14, "left": 14, "right": 14 },
      "unit": "mm"
    }
  },
  "variables": {},
  "assets": { "yemenStateEmblem": { "assetId": "orbis.yemen.state-emblem", "type": "logo" } },
  "root": {
    "type": "Page",
    "id": "report-card-page",
    "children": [
      { "type": "Header", "id": "standard-header", "props": { "height": 22 }, "children": [
        { "type": "Image", "id": "header-emblem", "props": { "assetRef": "yemenStateEmblem", "position": { "x": 95, "y": 2, "width": 20, "height": 16 }, "width": 20, "height": 16, "fit": "contain" } },
        { "type": "Text", "id": "header-school-name", "props": { "content": "{{organization.nameAr | default:'اسم المدرسة'}}", "position": { "x": 15, "y": 6, "width": 180, "height": 7 }, "fontSize": 12, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } }
      ] },
      { "type": "Text", "id": "school-name", "props": { "content": "{{organization.nameAr | default:'اسم المدرسة'}}", "position": { "x": 15, "y": 15, "width": 180, "height": 8 }, "fontSize": 18, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "title", "props": { "content": "كشف درجات الطالب للفصل الدراسي", "position": { "x": 15, "y": 28, "width": 180, "height": 8 }, "fontSize": 15, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } },
      { "type": "Text", "id": "student", "props": { "content": "الطالب: {{student.nameAr | default:student.fullName}}", "position": { "x": 20, "y": 45, "width": 170, "height": 7 }, "fontSize": 12, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.3 } },
      { "type": "Text", "id": "period", "props": { "content": "الفترة: {{periodName}}", "position": { "x": 20, "y": 55, "width": 170, "height": 7 }, "fontSize": 12, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.3 } },
      { "type": "Repeater", "id": "subject-results", "props": { "dataSource": "subjects", "itemVariable": "subject", "layout": "vertical", "gap": 2 }, "children": [
        { "type": "Text", "id": "subject-row", "props": { "content": "{{subject.subjectName}}    {{subject.totalScore | number:'0.00'}}    {{subject.gradeLabel}}", "position": { "x": 20, "y": 70, "width": 170, "height": 7 }, "fontSize": 10, "fontFamily": "Tahoma", "textAlign": "start", "direction": "rtl", "lineHeight": 1.2 } }
      ] },
      { "type": "Text", "id": "overall", "props": { "content": "المعدل العام: {{overallGpa | number:'0.00'}}    الناجح: {{passedSubjects}}    الراسب: {{failedSubjects}}", "position": { "x": 20, "y": 250, "width": 170, "height": 8 }, "fontSize": 12, "fontFamily": "Tahoma", "fontWeight": "bold", "textAlign": "start", "direction": "rtl", "lineHeight": 1.3 } },
      { "type": "Footer", "id": "standard-footer", "props": { "height": 12, "showPageNumber": true, "pageNumberFormat": "صفحة {{page}} من {{total}}" }, "children": [
        { "type": "Text", "id": "footer-content", "props": { "content": "{{organization.nameAr | default:'اسم المدرسة'}}  |  صفحة {{page}} من {{total}}", "position": { "x": 20, "y": 276, "width": 170, "height": 6 }, "fontSize": 8, "fontFamily": "Tahoma", "textAlign": "center", "direction": "rtl", "lineHeight": 1.2 } }
      ] }
    ]
  }
}
